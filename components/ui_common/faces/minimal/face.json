      "id": 1,
      "type": "choice",
      "label": "Style",
      "label_vi": "Kiểu",
      "default": 0,
      "choices": [
        {
          "label": "Light",
          "label_vi": "Sáng"
        },
        {
          "label": "Dark",
          "label_vi": "Tối"
        }
      ]
    },
    {
      "id": 2,
      "type": "toggle",
      "label": "Date",
      "label_vi": "Ngày",
      "default": true
    }
  ],
  "boards": {
    "paper": {
      "images": [
        {
          "digit_set": "thin",
          "format": "mono1",
          "dir": "digits-paper"
        }
      ],
      "elements": [
        {"kind": "rect", "x": 0, "y": 0, "w": 200, "h": 200, "fill": true, "colour": "white", "visible_if": [{"option": 1, "equals": 0}]},
        {"kind": "rect", "x": 0, "y": 0, "w": 200, "h": 200, "fill": true, "colour": "black", "visible_if": [{"option": 1, "equals": 1}]},
        {"kind": "text", "x": 0, "y": 26, "w": 200, "h": 20, "font": "small", "align": "center", "source": "ampm", "colour": "black", "visible_if": [{"option": 1, "equals": 0}]},
        {"kind": "text", "x": 0, "y": 26, "w": 200, "h": 20, "font": "small", "align": "center", "source": "ampm", "colour": "white", "visible_if": [{"option": 1, "equals": 1}]},
        {"kind": "number", "x": 0, "y": 54, "w": 200, "align": "center", "set": "thin", "source": "time", "colour": "black", "visible_if": [{"option": 1, "equals": 0}]},
        {"kind": "number", "x": 0, "y": 54, "w": 200, "align": "center", "set": "thin", "source": "time", "colour": "white", "visible_if": [{"option": 1, "equals": 1}]},
        {"kind": "text", "x": 0, "y": 126, "w": 200, "h": 22, "font": "small", "align": "center", "source": "date", "colour": "black", "visible_if": [{"option": 1, "equals": 0}, {"option": 2, "equals": 1}]},
        {"kind": "text", "x": 0, "y": 126, "w": 200, "h": 22, "font": "small", "align": "center", "source": "date", "colour": "white", "visible_if": [{"option": 1, "equals": 1}, {"option": 2, "equals": 1}]}
      ]
    }
  }
}
