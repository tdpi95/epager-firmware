{
  "$schema": "./registry.schema.json",
  "proto_major": 0,
  "limits": {
    "capabilities_max": 512,
    "max_message_config": 1024,
    "max_message_notification": 2048,
    "max_message_transfer": 1100,
    "max_message_status": 256,
    "seg_seq_modulo": 64,
    "seen_apps_max": 128,
    "notif_history_max": 50,
    "chunk_data_max": 1024,
    "ancs_title_max": 128,
    "ancs_subtitle_max": 128,
    "ancs_message_max": 1024
  },
  "text": {
