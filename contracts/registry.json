      ["0x000A", "0x000A"], ["0x0020", "0x007E"], ["0x00A0", "0x017F"], ["0x01A0", "0x01B0"],
      ["0x1E00", "0x1EFF"], ["0x2010", "0x2027"], ["0x2030", "0x203A"], ["0x20AB", "0x20AC"],
      ["0x2122", "0x2122"], ["0x25A1", "0x25A1"]
    ]
  },
  "status_codes": [
    {"id": 0, "name": "OK", "description": "Success."},
    {"id": 1, "name": "UNKNOWN_MESSAGE", "description": "Message type not known to the receiver."},
    {"id": 2, "name": "MALFORMED", "description": "Header or TLV structure invalid, wrong fixed width, bad bool, duplicate non-repeated field, tag 0, or below min_len."},
    {"id": 3, "name": "UNSUPPORTED_VERSION", "description": "Header ver is not the receiver's protocol major."},
    {"id": 4, "name": "MISSING_FIELD", "description": "A required field is absent."},
    {"id": 5, "name": "TOO_LARGE", "description": "Field longer than max_len, message larger than the channel limit, or payload larger than allowed."},
    {"id": 6, "name": "INVALID_UTF8", "description": "A str or id field is not valid UTF-8."},
    {"id": 7, "name": "INVALID_ID", "description": "An id field contains characters outside [a-z0-9._-] or starts with '.'."},
    {"id": 8, "name": "OUT_OF_RANGE", "description": "Integer outside min/max, or config enum value unknown to the board."},
    {"id": 9, "name": "UNKNOWN_KEY", "description": "Config key not known to (or not applicable on) this board; skipped."},
    {"id": 10, "name": "TYPE_MISMATCH", "description": "Config value length does not match the key's type."},
    {"id": 11, "name": "READ_ONLY", "description": "Config key cannot be written."},
    {"id": 12, "name": "REVISION_CONFLICT", "description": "expected_revision differs from the current config revision."},
    {"id": 13, "name": "INSUFFICIENT_SECURITY", "description": "Link not encrypted/bonded (non-BLE transports; BLE enforces this at the ATT layer)."},
    {"id": 14, "name": "BUSY", "description": "Another operation is in progress."},
    {"id": 15, "name": "NO_SPACE", "description": "Not enough storage."},
    {"id": 16, "name": "BAD_OFFSET", "description": "Chunk offset is not the next expected offset."},
    {"id": 17, "name": "NO_SESSION", "description": "Unknown or expired transfer handle."},
    {"id": 18, "name": "CRC_MISMATCH", "description": "CRC-32 of the received data does not match."},
    {"id": 19, "name": "HASH_MISMATCH", "description": "SHA-256 of the received data does not match."},
    {"id": 20, "name": "SIGNATURE_INVALID", "description": "Firmware signature missing or not trusted."},
    {"id": 21, "name": "IMAGE_INVALID", "description": "Firmware image or asset content fails format validation."},
    {"id": 22, "name": "LOW_BATTERY", "description": "Battery below the board's OTA threshold and no external power."},
    {"id": 23, "name": "VERSION_REJECTED", "description": "Firmware version is not newer than the running one."},
    {"id": 24, "name": "NOT_FOUND", "description": "Asset, app or notification not found."},
    {"id": 25, "name": "UNSUPPORTED", "description": "Feature, kind or asset type not supported by this board/variant."},
    {"id": 26, "name": "SEGMENT_ERROR", "description": "Segment sequence error during reassembly."},
    {"id": 27, "name": "INTERNAL", "description": "Unexpected internal error."}
  ],
  "enums": {
    "variant": {"fallback": 0, "values": [
      {"value": 0, "name": "unknown"}, {"value": 1, "name": "paper"}, {"value": 2, "name": "lcd"}]},
