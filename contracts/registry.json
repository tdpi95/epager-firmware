      {"bit": 6, "name": "animation"},
      {"bit": 9, "name": "touch"}, {"bit": 10, "name": "buttons"},
      {"bit": 11, "name": "climate"}, {"bit": 12, "name": "weather"}, {"bit": 13, "name": "wifi"}],
