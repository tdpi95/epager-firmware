{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epager.local/contracts/release-manifest.schema.json",
  "title": "ePager firmware release manifest (manifest.json), releases.md",
  "description": "Hand-written (not generated). Structural rules only; releases.md lists the checks a schema cannot express (unique board_id, file name). Unknown properties are allowed and ignored.",
  "type": "object",
  "required": ["manifest_version", "version", "contract_version", "images"],
  "properties": {
    "manifest_version": {"const": 1},
    "version": {"$ref": "#/$defs/release_version"},
    "contract_version": {"$ref": "#/$defs/core_version"},
    "images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}},
    "notes_url": {"type": "string", "pattern": "^https://", "maxLength": 512}
  },
  "$defs": {
    "core_version": {
      "description": "MAJOR.MINOR.PATCH, no leading zeros, at most 9 digits each.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "release_version": {
      "description": "MAJOR.MINOR.PATCH[-pre]; no build metadata (it would end up in asset file names).",
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "image": {
      "type": "object",
      "required": ["board_id", "variant", "file", "size", "sha256"],
      "properties": {
        "board_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"},
        "variant": {"description": "Registry enum `variant` name, e.g. paper.", "type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
        "file": {"type": "string", "pattern": "^epager-[a-z0-9_-]+-[0-9A-Za-z.-]+\\.bin$", "maxLength": 128},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "min_app_contract": {"$ref": "#/$defs/core_version"}
      }
    }
  }
}
