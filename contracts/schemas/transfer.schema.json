        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "STORAGE_INFO_RSP": {
      "type": "object",
      "additionalProperties": false,
