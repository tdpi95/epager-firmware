        "type": {
          "const": "XFER_FINISH"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handle": {
