  "$defs": {
    "XFER_BEGIN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x30 request on transfer. Start or resume a transfer.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "XFER_BEGIN"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "enum transfer_kind (unknown values -> 0): 0 unknown, 1 asset, 2 firmware"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-][a-z0-9._-]{0,31}$",
              "minLength": 1,
              "description": "id: max 32 UTF-8 bytes; min 1 bytes"
            },
            "asset_type": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "enum asset_type (unknown values -> 0): 0 unknown, 1 font, 2 background, 3 theme, 5 app_icon"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "crc32": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "sha256": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 64,
              "minLength": 64,
              "description": "hex-encoded bytes"
            },
            "version": {
              "type": "string",
              "description": "str: max 32 UTF-8 bytes"
            },
            "restart": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "size",
            "crc32",
            "sha256"
          ]
        }
      }
    },
    "XFER_BEGIN_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0xB0 response on transfer.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "XFER_BEGIN_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "handle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "prefix_crc32": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "max_chunk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "ack_window": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "XFER_CHUNK": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x31 request on transfer. Data at offset; answered by XFER_ACK events.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "XFER_CHUNK"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "data": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 2048,
              "minLength": 2,
              "description": "hex-encoded bytes"
            }
          },
          "required": [
            "handle",
            "offset",
            "data"
          ]
        }
      }
    },
    "XFER_STATUS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x32 request on transfer. Query a transfer.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "XFER_STATUS"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "handle"
          ]
        }
      }
    },
    "XFER_STATUS_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0xB2 response on transfer.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "XFER_STATUS_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
