{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epager.local/contracts/schemas/transfer.schema.json",
  "title": "ePager transfer messages (logical form, protocol.md 2.3)",
  "oneOf": [
    {
      "$ref": "#/$defs/XFER_BEGIN"
    },
    {
      "$ref": "#/$defs/XFER_BEGIN_RSP"
    },
    {
      "$ref": "#/$defs/XFER_CHUNK"
    },
    {
      "$ref": "#/$defs/XFER_STATUS"
    },
    {
      "$ref": "#/$defs/XFER_STATUS_RSP"
    },
    {
      "$ref": "#/$defs/XFER_FINISH"
    },
    {
      "$ref": "#/$defs/XFER_FINISH_RSP"
    },
    {
      "$ref": "#/$defs/XFER_ABORT"
    },
    {
      "$ref": "#/$defs/XFER_ABORT_RSP"
    },
    {
      "$ref": "#/$defs/STORAGE_INFO"
    },
    {
      "$ref": "#/$defs/STORAGE_INFO_RSP"
    },
    {
      "$ref": "#/$defs/ASSET_LIST"
    },
    {
      "$ref": "#/$defs/ASSET_LIST_RSP"
    },
    {
      "$ref": "#/$defs/ASSET_DELETE"
