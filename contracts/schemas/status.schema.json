{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epager.local/contracts/schemas/status.schema.json",
  "title": "ePager status messages (logical form, protocol.md 2.3)",
  "oneOf": [
    {
      "$ref": "#/$defs/PING"
    },
    {
      "$ref": "#/$defs/PING_RSP"
    },
    {
      "$ref": "#/$defs/DEVICE_STATUS"
    },
    {
      "$ref": "#/$defs/ERROR"
    }
  ],
  "$defs": {
    "PING": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x01 request on any. Echo request.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "PING"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payload": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 1024,
              "description": "hex-encoded bytes"
            }
          }
        }
      }
    },
    "PING_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x81 response on any.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "PING_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "payload": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 1024,
              "description": "hex-encoded bytes"
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "DEVICE_STATUS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x70 event on status. Device state; also the Status read value.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "DEVICE_STATUS"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "battery_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "0-100, 255 = unknown/no battery."
            },
            "external_power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "enum external_power (unknown values -> 2): 0 no, 1 yes, 2 unknown"
            },
            "uptime_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "notif_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "Notifications currently shown (passed the filters)."
            },
            "bonded_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "pairing_mode": {
              "type": "boolean"
            },
            "ota_state": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "enum ota_state (unknown values -> 0): 0 none, 1 pending_verify, 2 rolled_back, 3 updated"
            },
            "wifi_state": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Since 0.9.0, boards with the wifi feature.; enum wifi_state (unknown values -> 0): 0 unconfigured, 1 idle, 2 connecting, 3 connected, 4 auth_failed, 5 not_found, 6 no_internet"
            },
            "wifi_ssid": {
              "type": "string",
              "description": "Since 0.9.0: the stored network's name; absent when none is stored.; str: max 32 UTF-8 bytes"
            },
            "weather_state": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Since 0.9.0, boards with the weather feature.; enum weather_state (unknown values -> 0): 0 off, 1 waiting, 2 ok, 3 stale, 4 locate_failed, 5 fetch_failed"
            }
          }
        }
      }
    },
    "ERROR": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0xFF error on any. Unattributable request error.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "ERROR"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "msg_type": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Type byte of the offending message, if any."
            }
          },
          "required": [
            "status"
          ]
        }
      }
    }
  }
}
