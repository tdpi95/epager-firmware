{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epager.local/contracts/schemas/apps.schema.json",
  "title": "ePager apps messages (logical form, protocol.md 2.3)",
  "oneOf": [
    {
      "$ref": "#/$defs/APPS_LIST"
    },
    {
      "$ref": "#/$defs/APPS_LIST_RSP"
    },
    {
      "$ref": "#/$defs/APPS_SET_POLICY"
    },
    {
      "$ref": "#/$defs/APPS_SET_POLICY_RSP"
    },
    {
      "$ref": "#/$defs/APPS_FORGET"
    },
    {
      "$ref": "#/$defs/APPS_FORGET_RSP"
    },
    {
      "$ref": "#/$defs/APP_SEEN"
    }
  ],
  "$defs": {
    "APPS_LIST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x18 request on config. Page through seen apps.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_LIST"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        }
      }
    },
    "APPS_LIST_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x98 response on config.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_LIST_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "app": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/app_entry"
              }
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "APPS_SET_POLICY": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x19 request on config. Set per-app policies.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_SET_POLICY"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entry": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/policy_entry"
              }
            }
          },
          "required": [
            "entry"
          ]
        }
      }
    },
    "APPS_SET_POLICY_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x99 response on config.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_SET_POLICY_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "APPS_FORGET": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x1A request on config. Forget listed apps (none = all).",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_FORGET"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app_id": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "str: max 64 UTF-8 bytes; min 1 bytes"
              }
            }
          }
        }
      }
    },
    "APPS_FORGET_RSP": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x9A response on config.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APPS_FORGET_RSP"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "status code: 0 OK, 1 UNKNOWN_MESSAGE, 2 MALFORMED, 3 UNSUPPORTED_VERSION, 4 MISSING_FIELD, 5 TOO_LARGE, 6 INVALID_UTF8, 7 INVALID_ID, 8 OUT_OF_RANGE, 9 UNKNOWN_KEY, 10 TYPE_MISMATCH, 11 READ_ONLY, 12 REVISION_CONFLICT, 13 INSUFFICIENT_SECURITY, 14 BUSY, 15 NO_SPACE, 16 BAD_OFFSET, 17 NO_SESSION, 18 CRC_MISMATCH, 19 HASH_MISMATCH, 20 SIGNATURE_INVALID, 21 IMAGE_INVALID, 22 LOW_BATTERY, 23 VERSION_REJECTED, 24 NOT_FOUND, 25 UNSUPPORTED, 26 SEGMENT_ERROR, 27 INTERNAL"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "APP_SEEN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "description": "0x62 event on config. An app ID was seen for the first time.",
      "properties": {
        "ver": {
          "const": 0
        },
        "type": {
          "const": "APP_SEEN"
        },
        "req_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": {
              "$ref": "common.schema.json#/$defs/app_entry"
            }
          },
          "required": [
            "app"
          ]
        }
      }
    }
  }
}
