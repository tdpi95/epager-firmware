{
 "contract_version": "0.16.0",
 "description": "Board dispatch (protocol.md 2.1 and 2.4: reassembly, header checks, routing, security gate, body validation, answers segmented at the link MTU). Each case starts on a fresh connection with the given ATT MTU and security. For every 'write' to a characteristic the board must notify exactly the 'expect' segments, in order. No transfer session exists and only PING reaches a handler.",
 "scope": "board",
 "cases": [
  {
   "name": "ping_each_channel",
   "description": "PING is accepted on every request characteristic",
   "mtu": 517,
   "secure": true,
   "steps": [
    {
     "write": {
      "char": "config",
      "hex": "c000010100"
     },
     "expect": [
      {
       "char": "config",
       "hex": "c00081010001010000"
      }
     ]
    },
    {
     "write": {
      "char": "notification",
      "hex": "c00001020001010001"
     },
     "expect": [
      {
       "char": "notification",
       "hex": "c0008102000101000002010001"
      }
     ]
    },
    {
     "write": {
      "char": "transfer",
      "hex": "c000010300"
     },
     "expect": [
      {
       "char": "transfer",
       "hex": "c00081030001010000"
      }
     ]
    }
   ]
  },
